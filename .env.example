# LabLens environment variables — copy this file to `.env` and fill in.

# --- LLM provider selection (one of: gemini, anthropic, ollama). Default: gemini.
LABLENS_LLM_PROVIDER=gemini

# --- Gemini (default; free via Prompt Opinion or Google AI Studio)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Anthropic (alternative; pay-per-call)
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Ollama (alternative; local, free, requires ollama running on your machine)
# Default URL is http://localhost:11434; uncomment to override.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Server config
PORT=8000
NODE_ENV=development
